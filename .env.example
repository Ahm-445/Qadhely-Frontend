# Base URL of the Qadhely backend, without a trailing slash.
# Copy this file to .env and set your own value. Restart `expo start` after changing it.
#   Android emulator:  http://10.0.2.2:3000
#   Physical phone:    http://<your computer's LAN IP>:3000
EXPO_PUBLIC_API_URL=

# Username of the Qadhely Telegram bot (e.g. QadhelyBot), used by "Add from Telegram" on the
# Add items tab. Leave empty to hide that shortcut.
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=
